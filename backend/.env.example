# Copier en .env (jamais commité) et adapter.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# En production derrière un proxy HTTPS : DJANGO_DEBUG=false et une vraie clé.
CELERY_BROKER_URL=redis://localhost:6379/0
# Notification de la praticienne à chaque nouvelle demande
STUDIO_EMAIL=
STUDIO_NOM=
DEFAULT_FROM_EMAIL=reservations@localhost
# SMTP (sinon les e-mails s'affichent dans la console) :
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# Vide = SQLite. Renseigner pour PostgreSQL :
DATABASE_HOST=
DATABASE_NAME=beautyaura
DATABASE_USER=beautyaura
DATABASE_PASSWORD=
